.git
data
bin
web/node_modules
web/.next
**/.DS_Store
*.db
# Anchored patterns miss web/.env.local, which Next would inline into the
# embedded export via NEXT_PUBLIC_*; mirror .gitignore's triple.
**/.env
**/.env.*
!.env.example
# Built by the web stage inside the image; never ship the tracked copy.
web/out
# The browser suite and its output: the image's next build must not type-check
# the specs, and a local report holds the run's keys.
web/e2e
web/playwright.config.ts
web/playwright-report
web/test-results
