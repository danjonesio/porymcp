# PoryMCP configuration. Step one: copy this file to .env and set
# ADMIN_API_KEY and ENCRYPTION_KEY. A line here is uncommented only when you must set it;
# everything that merely restates a default stays commented out, so copying
# this file unchanged overrides nothing.

# Required. The admin API key for the management API and the dashboard: any
# long random value. Generate and paste:
#   openssl rand -hex 32
# Compose refuses every command without it (down and logs included). This is
# the value you sign in to the dashboard with.
# ADMIN_API_KEY=

# Required. 32 random bytes as 64 hex characters. Generate and paste:
#   openssl rand -hex 32
# Compose refuses every command without it (down and logs included). Used to
# encrypt upstream credentials at rest. Back it up separately from the data
# volume: losing it makes every stored credential unrecoverable.
# Already have a data volume with stored credentials? Do NOT generate a new
# key here. See docs/11-deployment.md section 12 first.
# ENCRYPTION_KEY=

# Rotation window only: the previous key(s), comma-separated, oldest last,
# 64 hex chars or base64 (a raw key: printf %s "$KEY" | xxd -p), at most five,
# accepted for decryption only. Set it, restart, run `porymcp rekey`, verify,
# then remove it and restart. See docs/11-deployment.md section 12.
# ENCRYPTION_KEY_PREVIOUS=

# SQLite file inside the data volume by default. The Postgres profile needs
# BOTH of these together (this value AND `--profile postgres`), or Postgres
# runs beside an app that is still on SQLite:
#   DATABASE_URL=postgres://porymcp:porymcp@postgres:5432/porymcp
# DATABASE_URL=sqlite:///data/porymcp.db

# Public URL used when minting virtual key proxy_url values.
# PUBLIC_URL=http://localhost:8080

# LISTEN_ADDR and DATA_DIR are image settings with no compose pass-through.
# Setting them here has no effect under docker compose (the Dockerfile sets
# them; see the note in docker-compose.yml). They apply to a bare binary only.
# LISTEN_ADDR=:8080
# LOG_LEVEL=info
# DATA_DIR=/data

# Comma-separated CIDRs trusted for X-Forwarded-For and for host/scheme resolution.
# Empty (default) = trust nobody; the admin-auth limiter keys on the socket IP.
# TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# Permit plain HTTP when PUBLIC_URL is https. Default unset/false.
# ALLOW_INSECURE_HTTP=false

# Permit localhost Host values when PUBLIC_URL is not localhost. Default unset/false.
# ALLOW_LOCALHOST=false

# Extra allowed Host values (comma-separated, no scheme). Default empty.
# EXTRA_ALLOWED_HOSTS=

# Built-in TLS certificate and key. Both must be set, or both left empty. Default empty.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
